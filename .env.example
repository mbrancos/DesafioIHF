SUPABASE_PROJECT_NAME="DesafioIHF"
SUPABASE_PROJECT_ID="seu_project_id_aqui"
SUPABASE_PROJECT_REGION="sa-east-1"
SUPABASE_DB_PASSWORD="sua_senha_do_banco_aqui"
SUPABASE_ACCESS_TOKEN="seu_token_de_acesso_aqui"
SUPABASE_URL="https://seu_project_id.supabase.co"

DATABASE_URL="postgresql://postgres.seu_project_id:sua_senha@aws-0-sa-east-1.pooler.supabase.com:6543/postgres"
DIRECT_URL="postgresql://postgres.seu_project_id:sua_senha@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"
